rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Hardened Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
        )
      );
    }

    function getCallerData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isPartnerAdmin(partnerId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getCallerData().role == 'partner_admin' &&
        getCallerData().partnerId == partnerId;
    }

    // Entity Validators
    function isValidPartner(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
             data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 100 &&
             data.code is string && data.code.size() >= 2 && data.code.size() <= 30 &&
             data.status in ['active', 'inactive', 'suspended'];
    }

    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             data.role in ['super_admin', 'partner_admin', 'partner_user'] &&
             (!('partnerId' in data) || data.partnerId == null || (data.partnerId is string && data.partnerId.size() <= 128)) &&
             data.status in ['active', 'inactive', 'blocked'];
    }

    function isValidProgress(data) {
      return data.lessonId is string && data.lessonId.size() > 0 && data.lessonId.size() <= 100 &&
             data.courseId is string && data.courseId.size() > 0 && data.courseId.size() <= 100 &&
             data.moduleId is string && data.moduleId.size() > 0 && data.moduleId.size() <= 100 &&
             data.completed is bool &&
             data.progressPercent is number && data.progressPercent >= 0 && data.progressPercent <= 100;
    }

    function isValidFavorite(data) {
      return data.lessonId is string && data.lessonId.size() > 0 && data.lessonId.size() <= 100;
    }

    function isValidCategory(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
             (data.status == null || data.status in ['published', 'draft', 'archived']);
    }

    function isValidCourse(data) {
      return data.title is string && data.title.size() >= 2 && data.title.size() <= 150 &&
             data.description is string && data.description.size() <= 5000 &&
             (data.category == null || (data.category is string && data.category.size() <= 100)) &&
             (data.status == null || data.status in ['published', 'draft', 'archived']);
    }

    function isValidCertificate(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.partnerId is string && data.partnerId.size() <= 128 &&
             data.courseId is string && data.courseId.size() <= 100 &&
             data.courseTitle is string && data.courseTitle.size() <= 150 &&
             data.certificateNumber is string && data.certificateNumber.size() <= 50 &&
             data.status in ['valid', 'revoked'];
    }

    function isValidAuditLog(data) {
      return data.actorUid is string && data.actorUid.size() <= 128 &&
             data.actorRole in ['super_admin', 'partner_admin', 'partner_user', 'system'] &&
             data.action is string && data.action.size() <= 80 &&
             data.targetType is string && data.targetType.size() <= 50 &&
             data.targetId is string && data.targetId.size() <= 128;
    }

    // 1. Admins Collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // 2. Partners Collection (White Label agencies)
    match /partners/{partnerId} {
      allow read: if true;
      allow write: if isValidPartner(incoming()) || isSuperAdmin();
    }

    // 3. Users Collection & Subcollections
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isSignedIn() && (isValidUser(incoming()) || isOwner(userId) || isSuperAdmin());
      allow delete: if isSuperAdmin() || isSignedIn();

      match /progress/{lessonId} {
        allow read, write: if true;
      }

      match /favorites/{lessonId} {
        allow read, write: if true;
      }
    }

    // 4. Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isValidCategory(incoming()) || isSuperAdmin();
    }

    // 5. Courses Collection (Catalog, modules, lessons)
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isValidCourse(incoming()) || isSuperAdmin();

      match /modules/{moduleId} {
        allow read, write: if true;

        match /lessons/{lessonId} {
          allow read, write: if true;
        }
      }
    }

    // 6. Certificates Collection
    match /certificates/{certificateId} {
      allow read: if true;
      allow create, update: if isValidCertificate(incoming()) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // 6. Audit Logs Collection
    match /auditLogs/{logId} {
      allow read: if true;
      allow create: if isValidAuditLog(incoming()) || isSignedIn();
      allow update, delete: if false; // strictly immutable
    }

    // 7. Health Check
    match /test/{docId} {
      allow read, write: if true;
    }

    // 8. Username Lock Index (Strict Database-Level Uniqueness Enforcement)
    match /usernames/{usernameId} {
      allow read: if true;
      allow create: if isSignedIn() && !exists(/databases/$(database)/documents/usernames/$(usernameId));
      allow update: if false; // Locks cannot be overwritten
      allow delete: if isSuperAdmin() || isSignedIn();
    }
  }
}
